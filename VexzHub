--// Kill Switch
_G.FastAttack = false

--// Services
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

--// Remote
local remote = ReplicatedStorage:WaitForChild("Modules")
    :WaitForChild("Net")
    :WaitForChild("RE/RegisterHit")

--// Config
local attackId = "079baa9c"
local BASE_CD = 0.1
local BURST = 2 -- số hit mỗi lần (2 = nhanh + an toàn)

--// Lấy target gần nhất
local function getTarget()
    local char = Players.LocalPlayer.Character
    if not char or not char:FindFirstChild("HumanoidRootPart") then return nil end
    
    local root = char.HumanoidRootPart

    for _, v in pairs(workspace:GetDescendants()) do
        if v:IsA("Model") and v ~= char then
            local hum = v:FindFirstChild("Humanoid")
            local hrp = v:FindFirstChild("HumanoidRootPart")

            if hum and hrp and hum.Health > 0 then
                if (hrp.Position - root.Position).Magnitude < 25 then
                    return hrp
                end
            end
        end
    end
end

--// START
function startFastAttack()
    if _G.FastAttack then return end
    _G.FastAttack = true

    task.spawn(function()
        while _G.FastAttack do
            
            local target = getTarget()

            if target then
                local args = {
                    [1] = target,
                    [2] = {target},
                    [3] = nil,
                    [4] = attackId
                }

                -- ⚡ burst attack
                for i = 1, BURST do
                    remote:FireServer(unpack(args))
                end
            end

            task.wait(BASE_CD)
        end
    end)
end

--// STOP
function stopFastAttack()
    _G.FastAttack = false
end
