-- Fast Attack — GOD SPEED v5 — by Quoc Hoa
_G.FastAttack = true

local Players           = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService        = game:GetService("RunService")
local VIM               = game:GetService("VirtualInputManager")
local LocalPlayer       = Players.LocalPlayer

local HitRemote = ReplicatedStorage:FindFirstChild("Modules")
    and ReplicatedStorage.Modules:FindFirstChild("Net")
    and ReplicatedStorage.Modules.Net:FindFirstChild("RE/RegisterHit")

local hash = "079baa9c"
pcall(function()
    if not HitRemote then return end
    local mt = getrawmetatable(game)
    local old = mt.__namecall
    setreadonly(mt, false)
    mt.__namecall = newcclosure(function(self, ...)
        if getnamecallmethod() == "FireServer" and self == HitRemote then
            local a = {...}
            if type(a[4]) == "string" and #a[4] >= 6 then hash = a[4] end
        end
        return old(self, ...)
    end)
    setreadonly(mt, true)
end)

local function cancelAll()
    local char = LocalPlayer.Character
    if not char then return end
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not hum then return end
    for _, track in ipairs(hum:GetPlayingAnimationTracks()) do
        track:Stop(0)
    end
end

local function getRoot()
    local c = LocalPlayer.Character
    return c and c:FindFirstChild("HumanoidRootPart")
end

local cachedMobs = {}
local frame = 0

-- ═══════════════════════════════════════════
-- LOOP CHÍNH — 60 FPS
-- ═══════════════════════════════════════════
RunService.RenderStepped:Connect(function()
    if not _G.FastAttack then return end

    cancelAll()

    -- Click ×20 = 1200 clicks/giây
    for _ = 1, 20 do
        VIM:SendMouseButtonEvent(0, 0, 0, true,  game, 1)
        VIM:SendMouseButtonEvent(0, 0, 0, false, game, 1)
    end

    cancelAll()

    frame += 1
    if frame >= 1 then
        frame = 0
        local r = getRoot()
        if r then
            local E = workspace:FindFirstChild("Enemies")
            cachedMobs = {}
            if E then
                for _, e in ipairs(E:GetChildren()) do
                    if not e:IsA("Model") then continue end
                    local h  = e:FindFirstChildOfClass("Humanoid")
                    local er = e:FindFirstChild("HumanoidRootPart")
                    if h and h.Health > 0 and er and (r.Position - er.Position).Magnitude <= 200 then
                        table.insert(cachedMobs, er)
                    end
                end
            end
        end
    end

    -- FireServer ×10 mỗi mob = 600 lần/giây/mob
    for _, mr in ipairs(cachedMobs) do
        pcall(function()
            for _ = 1, 10 do
                HitRemote:FireServer(mr, {}, hash)
            end
        end)
    end
end)

-- Loop phụ cancel ×5
task.spawn(function()
    while _G.FastAttack do
        cancelAll()
        task.wait(0)
        cancelAll()
        task.wait(0)
        cancelAll()
        task.wait(0)
        cancelAll()
        task.wait(0)
        cancelAll()
        task.wait(0)
    end
end)

print("[FastAttack GOD v5] ON") 
