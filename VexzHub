local S = {
    farm = false,
    bring = false,
    quest = false,
    active = false,
    questBusy = false,
    target = nil,
    noFallConn = nil,
    bringCount = 3,
    bringRange = 300,
    origGravity = workspace.Gravity,
}

local function getRoot()
    local c = LocalPlayer.Character
    return c and c:FindFirstChild("HumanoidRootPart")
end

local function getHum()
    local c = LocalPlayer.Character
    return c and c:FindFirstChildOfClass("Humanoid")
end

local function resetState()
    S.active = false
    S.target = nil
    if S.noFallConn then S.noFallConn:Disconnect(); S.noFallConn = nil end
    workspace.Gravity = S.origGravity
    local c = LocalPlayer.Character
    if not c then return end
    local h = c:FindFirstChildOfClass("Humanoid")
    if h then h.WalkSpeed=16; h.JumpPower=50; h.PlatformStand=false; h.AutoRotate=true end
    local r = c:FindFirstChild("HumanoidRootPart")
    if r then r.Velocity=Vector3.zero; r.AssemblyLinearVelocity=Vector3.zero end
    for _, p in ipairs(c:GetDescendants()) do
        if p:IsA("BasePart") then p.CanCollide=true end
    end
end

local function lockChar()
    local c = LocalPlayer.Character
    if not c then return end
    local h = c:FindFirstChildOfClass("Humanoid")
    if h then h.WalkSpeed=0; h.JumpPower=0; h.PlatformStand=true; h.AutoRotate=false end
    for _, p in ipairs(c:GetDescendants()) do
        if p:IsA("BasePart") and p.Name~="HumanoidRootPart" then p.CanCollide=false end
    end
end

local function startNoFall(mob)
    if S.noFallConn then S.noFallConn:Disconnect(); S.noFallConn = nil end
    workspace.Gravity = 0
    lockChar()
    S.noFallConn = RunService.RenderStepped:Connect(function()
        if not S.active then return end
        local r = getRoot()
        if not r or not mob or not mob.Parent then return end
        local er = mob:FindFirstChild("HumanoidRootPart")
        local eh = mob:FindFirstChildOfClass("Humanoid")
        if not er or not eh or eh.Health<=0 then return end
        r.CFrame = er.CFrame * CFrame.new(0,10,0)
        r.Velocity = Vector3.zero
        r.RotVelocity = Vector3.zero
        r.AssemblyLinearVelocity = Vector3.zero
        r.AssemblyAngularVelocity = Vector3.zero
    end)
end

local function flyTo(pos, speed)
    speed = speed or 300
    if S.noFallConn then S.noFallConn:Disconnect(); S.noFallConn = nil end
    workspace.Gravity = 0
    lockChar()
    local done = false
    local conn
    conn = RunService.RenderStepped:Connect(function(dt)
        local r = getRoot()
        if not r then conn:Disconnect(); done=true; return end
        local diff = pos - r.Position
        if diff.Magnitude < 4 then
            r.CFrame = CFrame.new(pos)
            r.Velocity = Vector3.zero
            r.AssemblyLinearVelocity = Vector3.zero
            conn:Disconnect(); done=true; return
        end
        local step = math.min(speed*dt, diff.Magnitude)
        r.CFrame = CFrame.new(r.Position + diff.Unit*step)
        r.Velocity = Vector3.zero
        r.AssemblyLinearVelocity = Vector3.zero
    end)
    local t=0
    repeat task.wait(0.05); t+=0.05 until done or t>=15
end

local function findMobs(fromPos, maxDist)
    local Enemies = workspace:FindFirstChild("Enemies")
    if not Enemies then return nil, math.huge, {} end
    local closest, closestDist = nil, maxDist or math.huge
    local nearby = {}
    for _, e in ipairs(Enemies:GetChildren()) do
        if not e:IsA("Model") then continue end
        local eh = e:FindFirstChildOfClass("Humanoid")
        local er = e:FindFirstChild("HumanoidRootPart")
        if not eh or eh.Health<=0 or not er then continue end
        local dist = (fromPos - er.Position).Magnitude
        if dist <= (maxDist or math.huge) then
            table.insert(nearby, {mob=e, dist=dist})
            if dist < closestDist then closestDist = dist; closest = e end
        end
    end
    return closest, closestDist, nearby
end

local function bringMobs()
    local r = getRoot()
    if not r then return end
    local Enemies = workspace:FindFirstChild("Enemies")
    if not Enemies then return end
    local count = 0
    for _, e in ipairs(Enemies:GetChildren()) do
        if count >= S.bringCount then break end
        if not e:IsA("Model") then continue end
        local eh = e:FindFirstChildOfClass("Humanoid")
        local er = e:FindFirstChild("HumanoidRootPart")
        if not eh or eh.Health<=0 or not er then continue end
        local dist = (r.Position - er.Position).Magnitude
        if dist <= S.bringRange then
            pcall(function()
                -- Dùng TweenService di chuyển quái về (không freeze hoàn toàn để tránh lỗi dame)
                local targetPos = r.Position + Vector3.new(math.random(-6,6), 0, math.random(-6,6))
                local tween = TweenService:Create(er, TweenInfo.new(0.3, Enum.EasingStyle.Linear), {CFrame = CFrame.new(targetPos)})
                tween:Play()
                -- Giảm tốc độ thay vì freeze hoàn toàn
                eh.WalkSpeed = 2
                eh.JumpPower = 0
            end)
            count += 1
        end
    end
end

local function doAcceptQuest()
    if S.questBusy then return end
    S.questBusy = true

    local info = CheckQuest()
    if not info then
        S.questBusy = false
        return
    end

    flyTo(info.CFrameQuest.Position + Vector3.new(0,3,-5), 300)
    task.wait(0.5)

    local questTaken = false
    for _, v in ipairs(workspace:GetDescendants()) do
        if v:IsA("ProximityPrompt") and (v.ActionText or ""):lower():find("quest") then
            local rootPart = v.Parent
            if rootPart and rootPart:IsA("BasePart") then
                local dist = (getRoot().Position - rootPart.Position).Magnitude
                if dist < 15 then
                    pcall(function()
                        fireproximityprompt(v)
                        task.wait(0.3)
                        fireproximityprompt(v)
                        questTaken = true
                    end)
                    break
                end
            end
        end
    end

    if not questTaken then
        pcall(function()
            if QuestRemote then
                QuestRemote:FireServer(info.NameQuest)
                task.wait(0.3)
                QuestRemote:FireServer(info.NameQuest, true)
            end
        end)
    end

    task.wait(0.5)

    if S.farm then
        flyTo(info.CFrameMon.Position + Vector3.new(0,10,0), 300)
        if S.target and S.target.Parent then
            S.active = true
            startNoFall(S.target)
        else
            local r = getRoot()
            if r then
                local next = findMobs(r.Position, 2000)
                if next then
                    S.target = next
                    S.active = true
                    startNoFall(next)
                end
            end
        end
    end

    S.questBusy = false
end

task.spawn(function()
    while true do
        task.wait()
        if not S.farm or S.questBusy then
            if S.active and not S.questBusy then resetState() end
            continue
        end
        local r = getRoot()
        local h = getHum()
        if not r or not h or h.Health<=0 then
            if S.active then resetState() end
            task.wait(0.2); continue
        end
        local closest, _, nearby = findMobs(r.Position, 2000)
        if closest then
            if not S.active then
                S.active = true; S.target = closest; startNoFall(closest)
            end
            if S.target then
                local teh = S.target:FindFirstChildOfClass("Humanoid")
                if not teh or teh.Health<=0 or not S.target.Parent then
                    S.target = closest; startNoFall(closest)
                end
            end
            for _, item in ipairs(nearby) do
                if not S.farm then break end
                if item.dist > 300 then continue end
                local mob = item.mob
                local er = mob:FindFirstChild("HumanoidRootPart")
                local eh = mob:FindFirstChildOfClass("Humanoid")
                if not eh or eh.Health<=0 or not er then continue end
                pcall(function()
                    if realAttackArgs and #realAttackArgs>0 then
                        local args = table.clone(realAttackArgs)
                        args[1] = er
                        AttackRemote:FireServer(table.unpack(args))
                    else
                        AttackRemote:FireServer(er, {})
                    end
                end)
            end
            VirtualInputManager:SendMouseButtonEvent(0,0,0,true,game,1)
            VirtualInputManager:SendMouseButtonEvent(0,0,0,false,game,1)
        else
            if S.active then resetState() end
            if S.farm and not S.questBusy then
                local r2 = getRoot()
                if r2 then
                    local next = findMobs(r2.Position, 2000)
                    if next then
                        local er = next:FindFirstChild("HumanoidRootPart")
                        if er then
                            flyTo(er.Position + Vector3.new(0,10,0), 300)
                            S.active = true; S.target = next; startNoFall(next)
                        end
                    end
                end
            end
        end
    end
end)

task.spawn(function()
    while true do
        task.wait(2)
        if S.farm and S.bring then bringMobs() end
    end
end)

