-- Fast Attack Bypass — by Quoc Hoa
-- Kỹ thuật: đánh nhiều mob cùng lúc mỗi frame
-- → server nhận nhiều hit packet riêng biệt
-- → damage nhân theo số mob bị hit
_G.FastAttack = true

local Players           = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService        = game:GetService("RunService")
local VIM               = game:GetService("VirtualInputManager")
local LocalPlayer       = Players.LocalPlayer

local HitRemote = ReplicatedStorage.Modules.Net:FindFirstChild("RE/RegisterHit")

-- Hook hash tự động
local hash = "079baa9c"
pcall(function()
    local mt = getrawmetatable(game)
    local old = mt.__namecall
    setreadonly(mt, false)
    mt.__namecall = newcclosure(function(self, ...)
        if getnamecallmethod() == "FireServer" and self == HitRemote then
            local a = {...}
            if type(a[4]) == "string" and #a[4] == 8 then
                hash = a[4]
                print("[FA] Hash updated:", hash)
            end
        end
        return old(self, ...)
    end)
    setreadonly(mt, true)
    print("[FA] Hook OK")
end)

local function getRoot()
    local c = LocalPlayer.Character
    return c and c:FindFirstChild("HumanoidRootPart")
end

-- Lấy TẤT CẢ mob trong range để hit cùng lúc
local function getAllMobs(maxDist)
    local root = getRoot()
    if not root then return {} end
    local Enemies = workspace:FindFirstChild("Enemies")
    if not Enemies then return {} end

    local list = {}
    for _, e in ipairs(Enemies:GetChildren()) do
        if not e:IsA("Model") then continue end
        local h = e:FindFirstChildOfClass("Humanoid")
        local r = e:FindFirstChild("HumanoidRootPart")
        if not h or h.Health <= 0 or not r then continue end
        if (root.Position - r.Position).Magnitude <= maxDist then
            table.insert(list, e)
        end
    end
    return list
end

-- Bypass chính:
-- Gửi hit packet cho TỪNG mob trong range mỗi Heartbeat
-- Server xử lý mỗi packet độc lập → không bị throttle chung
RunService.Heartbeat:Connect(function()
    if not _G.FastAttack then return end

    local mobs = getAllMobs(150)  -- hit tất cả mob trong 150 studs
    if #mobs == 0 then return end

    for _, mob in ipairs(mobs) do
        local h = mob:FindFirstChildOfClass("Humanoid")
        local r = mob:FindFirstChild("HumanoidRootPart")
        if not h or h.Health <= 0 or not r then continue end

        -- Gửi từng packet riêng biệt cho mỗi mob
        local args = { [1] = r, [2] = {}, [4] = hash }
        pcall(function() HitRemote:FireServer(unpack(args)) end)
    end

    -- VirtualInput click thêm để trigger animation
    VIM:SendMouseButtonEvent(0, 0, 0, true,  game, 1)
    VIM:SendMouseButtonEvent(0, 0, 0, false, game, 1)
end)

print("[FastAttack] ON | hash:", hash)
print("[FastAttack] OFF: _G.FastAttack = false")
 
