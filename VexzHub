local function getPlayerLevel()
    local stats = LocalPlayer:FindFirstChild("leaderstats")
    if stats then
        local lv = stats:FindFirstChild("Level") or stats:FindFirstChild("Lv")
        if lv then return tonumber(lv.Value) or 1 end
    end
    return 1
end

local function getQuestData(lv)
    for i = #QuestData, 1, -1 do
        local d = QuestData[i]
        if lv >= d[1] then
            return {
                minLv    = d[1],
                maxLv    = d[2],
                questNPC = d[3],  -- tên NPC Model
                npcTitle = d[4],  -- tên hiển thị
                mobName  = d[5],  -- tên mob
            }
        end
    end
    return { minLv=1, maxLv=15, questNPC=QuestData[1][3], npcTitle=QuestData[1][4], mobName=QuestData[1][5] }
end

