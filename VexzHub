local function getLv()
    local ok,v=pcall(function()return LP.Data.Level.Value end)
    if ok and v then return v end
    local s=LP:FindFirstChild("leaderstats")
    if s then local l=s:FindFirstChild("Level")or s:FindFirstChild("Lv");if l then return tonumber(l.Value)or 1 end end
    return 1
end

local function getQD(lv)
    for i=#QD,1,-1 do if lv>=QD[i][1] then return{questName=QD[i][3],cfQ=QD[i][4],cfM=QD[i][5],ent=QD[i][6]} end end
    return{questName=QD[1][3],cfQ=QD[1][4],cfM=QD[1][5],ent=nil}
end

-- STATE
local S={farm=false,bring=false,quest=false,active=false,qBusy=false,
         target=nil,nfc=nil,brc=nil,htc=nil,bc=5,origG=workspace.Gravity}

local function R() return LP.Character and LP.Character:FindFirstChild("HumanoidRootPart") end
local function H() return LP.Character and LP.Character:FindFirstChildOfClass("Humanoid") end

local function resetChar()
    S.active=false;S.target=nil
    if S.nfc then S.nfc:Disconnect();S.nfc=nil end
    workspace.Gravity=S.origG
    local c=LP.Character;if not c then return end
    local h=c:FindFirstChildOfClass("Humanoid")
    if h then h.WalkSpeed=16;h.JumpPower=50;h.PlatformStand=false;h.AutoRotate=true end
    local r=c:FindFirstChild("HumanoidRootPart")
    if r then r.Velocity=Vector3.zero;r.AssemblyLinearVelocity=Vector3.zero end
    for _,p in ipairs(c:GetDescendants())do if p:IsA("BasePart")then p.CanCollide=true end end
end

local function lockChar()
    local c=LP.Character;if not c then return end
    local h=c:FindFirstChildOfClass("Humanoid")
    if h then h.WalkSpeed=0;h.JumpPower=0;h.PlatformStand=true;h.AutoRotate=false end
    for _,p in ipairs(c:GetDescendants())do
        if p:IsA("BasePart")and p.Name~="HumanoidRootPart" then p.CanCollide=false end
    end
end

-- NOFAIL Y+18
local function startNF(mob)
    if S.nfc then S.nfc:Disconnect();S.nfc=nil end
    workspace.Gravity=0;lockChar()
    S.nfc=RunService.RenderStepped:Connect(function()
        if not S.active then return end
        local r=R();if not r or not mob or not mob.Parent then return end
        local er=mob:FindFirstChild("HumanoidRootPart")
        local eh=mob:FindFirstChildOfClass("Humanoid")
        if not er or not eh or eh.Health<=0 then return end
        r.CFrame=er.CFrame*CFrame.new(0,18,0)
        r.Velocity=Vector3.zero;r.RotVelocity=Vector3.zero
        r.AssemblyLinearVelocity=Vector3.zero;r.AssemblyAngularVelocity=Vector3.zero
    end)
end

-- FLY TO — smooth lerp
local function flyTo(pos,spd)
    spd=spd or 300
    if S.nfc then S.nfc:Disconnect();S.nfc=nil end
    workspace.Gravity=0;lockChar()
    local done=false;local cn
    cn=RunService.RenderStepped:Connect(function(dt)
        local r=R();if not r then cn:Disconnect();done=true;return end
        local d=pos-r.Position
        if d.Magnitude<4 then
            r.CFrame=CFrame.new(pos);r.Velocity=Vector3.zero;r.AssemblyLinearVelocity=Vector3.zero
            cn:Disconnect();done=true;return
        end
        r.CFrame=CFrame.new(r.Position+d.Unit*math.min(spd*dt,d.Magnitude))
        r.Velocity=Vector3.zero;r.AssemblyLinearVelocity=Vector3.zero
    end)
    local t=0;repeat task.wait(0.05);t+=0.05 until done or t>=15
end

-- HITBOX EXPANDER — mở rộng hitbox mob để đánh từ trên cao
local function startHitbox()
    if S.htc then return end
    S.htc=RunService.Heartbeat:Connect(function()
        if not S.farm then S.htc:Disconnect();S.htc=nil;return end
        local E=workspace:FindFirstChild("Enemies");if not E then return end
        for _,e in ipairs(E:GetChildren())do
            if not e:IsA("Model")then continue end
            local eh=e:FindFirstChildOfClass("Humanoid")
            if not eh or eh.Health<=0 then continue end
            for _,p in ipairs(e:GetDescendants())do
                if p:IsA("BasePart")and p.Size.Magnitude<30 then
                    pcall(function()p.Size=Vector3.new(25,25,25)end)
                end
            end
        end
    end)
end

-- BRING MOB — RenderStepped set CFrame mỗi frame + freeze mob
local function startBring()
    if S.brc then S.brc:Disconnect();S.brc=nil end
    S.brc=RunService.RenderStepped:Connect(function()
        if not S.bring or not S.farm then S.brc:Disconnect();S.brc=nil;return end
        local r=R();if not r then return end
        local E=workspace:FindFirstChild("Enemies");if not E then return end
        local n=0
        for _,e in ipairs(E:GetChildren())do
            if n>=S.bc then break end
            if not e:IsA("Model")then continue end
            local eh=e:FindFirstChildOfClass("Humanoid")
            local er=e:FindFirstChild("HumanoidRootPart")
            if not eh or eh.Health<=0 or not er then continue end
            local dist=(r.Position-er.Position).Magnitude
            if dist>3000 or dist<3 then continue end
            local lp=r.Position+Vector3.new(math.random(-5,5),0,math.random(-5,5))
            pcall(function()
                er.CFrame=CFrame.new(lp)
                er.Velocity=Vector3.zero
                er.AssemblyLinearVelocity=Vector3.zero
                er.AssemblyAngularVelocity=Vector3.zero
                -- Freeze mob: destroy Animator + WalkSpeed=0
                for _,d in ipairs(e:GetDescendants())do
                    if d:IsA("Animator")or d.Name=="Animate" then
                        pcall(function()d:Destroy()end)
                    end
                end
                eh.WalkSpeed=0;eh.JumpPower=0
            end)
            n+=1
        end
    end)
end

local function stopBring()
    if S.brc then S.brc:Disconnect();S.brc=nil end
end

-- AUTO QUEST — teleport đến CFrameQuest thật, FireServer, bay đến CFrameMon
local function doQuest()
    if S.qBusy then return end
    S.qBusy=true
    local lv=getLv()
    local d=getQD(lv)
    print("[VexzHub] Quest Lv",lv,"->",d.questName)
    local r=R();if not r then S.qBusy=false;return end

    -- Xử lý entrance nếu cần
    local dist=(r.Position-d.cfQ.Position).Magnitude
    if dist>5000 and d.ent then
        if d.ent=="sub" then
            -- Teleport đến tàu ngầm
            pcall(function()r.CFrame=CFrame.new(-16269.7041,25.2288494,1373.65955,0.997390985,1.47309942e-09,-0.0721890926,-4.00651912e-09,0.99999994,-2.51183763e-09,0.0721890852,5.75363091e-10,0.997390926)end)
            task.wait(2)
            pcall(function()
                local rf=RS.Modules.Net:FindFirstChild("RF/SubmarineWorkerSpeak")
                if rf then rf:InvokeServer("TravelToSubmergedIsland") end
            end)
            task.wait(3)
        elseif typeof(d.ent)=="Vector3" then
            pcall(function()CommF:InvokeServer("requestEntrance",d.ent)end)
            task.wait(2)
        end
    end

    -- Teleport đến NPC (CFrameQuest chính xác)
    r=R()
    if r then pcall(function()r.CFrame=d.cfQ end) end
    task.wait(0.8)

    -- FireServer nhận quest
    pcall(function()
        if QuestRemote then
            QuestRemote:FireServer(d.questName,true)
            print("[VexzHub] Quest OK:",d.questName)
        end
    end)
    task.wait(0.4)

    -- Teleport đến vị trí mob (CFrameMon chính xác)
    r=R()
    if r then
        pcall(function()r.CFrame=d.cfM end)
    end
    task.wait(0.5)

    -- Tìm và bật farm lại
    if S.farm then
        local E=workspace:FindFirstChild("Enemies")
        if E then
            r=R()
            if r then
                -- Tìm mob gần nhất tại vị trí quest
                local best,bestDist=nil,math.huge
                for _,e in ipairs(E:GetChildren())do
                    if not e:IsA("Model")then continue end
                    local eh=e:FindFirstChildOfClass("Humanoid")
                    local er=e:FindFirstChild("HumanoidRootPart")
                    if not eh or eh.Health<=0 or not er then continue end
                    local dd=(r.Position-er.Position).Magnitude
                    if dd<bestDist then bestDist=dd;best=e end
                end
                if best then
                    S.target=best;S.active=true;startNF(best)
                    print("[VexzHub] Farm lại:",best.Name)
                end
            end
        end
    end

    S.qBusy=false
    print("[VexzHub] Quest cycle xong!")
end

-- FIND MOBS
local function findMobs(from,maxD)
    local E=workspace:FindFirstChild("Enemies")
    if not E then return nil,math.huge,{} end
    local cl,cd=nil,maxD or math.huge;local nb={}
    for _,e in ipairs(E:GetChildren())do
        if not e:IsA("Model")then continue end
        local eh=e:FindFirstChildOfClass("Humanoid")
        local er=e:FindFirstChild("HumanoidRootPart")
        if not eh or eh.Health<=0 or not er then continue end
        local d=(from-er.Position).Magnitude
        if d<=(maxD or math.huge) then
            table.insert(nb,{mob=e,dist=d})
            if d<cd then cd=d;cl=e end
        end
    end
    return cl,cd,nb
end

-- MAIN FARM LOOP
task.spawn(function()
    while true do
        task.wait()
        if not S.farm or S.qBusy then
            if S.active and not S.qBusy then resetChar() end;continue
        end
        local r=R();local h=H()
        if not r or not h or h.Health<=0 then
            if S.active then resetChar() end;task.wait(0.2);continue
        end
        local cl,_,nb=findMobs(r.Position,2000)
        if cl then
            if not S.active then S.active=true;S.target=cl;startNF(cl) end
            if S.target then
                local teh=S.target:FindFirstChildOfClass("Humanoid")
                if not teh or teh.Health<=0 or not S.target.Parent then
                    S.target=cl;startNF(cl)
                end
            end
            -- Tấn công mob trong 350 studs (hitbox to nên từ Y+18 vẫn hit)
            for _,item in ipairs(nb)do
                if not S.farm then break end
                if item.dist>350 then continue end
                local mob=item.mob
                local eh=mob:FindFirstChildOfClass("Humanoid")
                local er=mob:FindFirstChild("HumanoidRootPart")
                if not eh or eh.Health<=0 or not er then continue end
                pcall(function()
                    if RAA and #RAA>0 then
                        local a=table.clone(RAA);a[1]=er
                        AttackRemote:FireServer(table.unpack(a))
                    else
                        AttackRemote:FireServer(er,{})
                    end
                end)
            end
            VIM:SendMouseButtonEvent(0,0,0,true,game,1)
            VIM:SendMouseButtonEvent(0,0,0,false,game,1)
        else
            if S.active then resetChar() end
            if S.farm and not S.qBusy then
                r=R()
                if r then
                    local nx=findMobs(r.Position,5000)
                    if nx then
                        local er=nx:FindFirstChild("HumanoidRootPart")
                        if er then
                            flyTo(er.Position+Vector3.new(0,18,0),300)
                            S.active=true;S.target=nx;startNF(nx)
                        end
                    end
                end
            end
        end
    end
end)

