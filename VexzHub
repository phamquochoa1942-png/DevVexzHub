-- ╔══════════════════════════════════════════════════╗
-- ║  FAST ATTACK — ULTIMATE EDITION                ║
-- ║  Tốc độ: 5000+ hits/s | Bypass Server Delay    ║
-- ╚══════════════════════════════════════════════════╝
_G.FastAttack = true

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local VIM = game:GetService("VirtualInputManager")
local LP = game.Players.LocalPlayer

-- =====================================================
-- REMOTE + HASH
-- =====================================================
local HitRemote = ReplicatedStorage:FindFirstChild("Modules")
    and ReplicatedStorage.Modules:FindFirstChild("Net")
    and ReplicatedStorage.Modules.Net:FindFirstChild("RE/RegisterHit")

local HASH = "079baa9c"

if HitRemote then
    pcall(function()
        local mt = getrawmetatable(game)
        local old = mt.__namecall
        setreadonly(mt, false)
        mt.__namecall = newcclosure(function(self, ...)
            if self == HitRemote then
                local args = {...}
                if type(args[4]) == "string" and #args[4] >= 6 then
                    HASH = args[4]
                end
            end
            return old(self, ...)
        end)
        setreadonly(mt, true)
    end)
end

-- =====================================================
-- PRE-ALLOCATED
-- =====================================================
local _click1 = { 0, 0, 0, true,  game, 1 }
local _click2 = { 0, 0, 0, false, game, 1 }
local _args   = { nil, {}, HASH }
local _roots  = {}
local _count  = 0

local _sendClick = VIM.SendMouseButtonEvent
local _fireServer = HitRemote and HitRemote.FireServer

-- =====================================================
-- SMART BYPASS: Reset trạng thái quái để nhận hit
-- =====================================================
local _hitCounters = {}

local function SmartBypass(mob)
    local id = tostring(mob):match("%x+")
    if not _hitCounters[id] then
        _hitCounters[id] = 0
    end
    _hitCounters[id] += 1
    
    -- Mỗi 200 hits, reset trạng thái mob để tránh bị bỏ qua sát thương
    if _hitCounters[id] % 200 == 0 then
        pcall(function()
            local hum = mob:FindFirstChildOfClass("Humanoid")
            if hum and hum.Health > 0 then
                -- Tạm thay đổi WalkSpeed để server re-evaluate mob
                local oldSpeed = hum.WalkSpeed
                hum.WalkSpeed = 1
                task.wait(0.01)
                hum.WalkSpeed = oldSpeed
            end
        end)
    end
    
    -- Cleanup counter nếu quá lớn
    if _hitCounters[id] > 10000 then
        _hitCounters[id] = 0
    end
end

-- Cleanup cache khi mob chết
local function CleanupCounters()
    for id, _ in pairs(_hitCounters) do
        local found = false
        for i = 1, _count do
            local mr = _roots[i]
            if mr and mr.Parent then
                local mid = tostring(mr.Parent):match("%x+")
                if mid == id then found = true; break end
            end
        end
        if not found then _hitCounters[id] = nil end
    end
end

-- =====================================================
-- CANCEL ANIMS
-- =====================================================
local function CancelAnims(hum)
    for _, t in ipairs(hum:GetPlayingAnimationTracks()) do t:Stop(0) end
end

-- =====================================================
-- SCAN MOBS
-- =====================================================
local function ScanMobs(root)
    _count = 0
    local E = workspace:FindFirstChild("Enemies")
    if not E then return end
    local rx, ry, rz = root.Position.X, root.Position.Y, root.Position.Z
    for _, e in ipairs(E:GetChildren()) do
        if e:IsA("Model") then
            local h = e:FindFirstChildOfClass("Humanoid")
            if h and h.Health > 0 then
                local er = e:FindFirstChild("HumanoidRootPart")
                if er then
                    local dx = rx - er.Position.X
                    local dy = ry - er.Position.Y
                    local dz = rz - er.Position.Z
                    if dx*dx + dy*dy + dz*dz <= 40000 then
                        _count += 1
                        _roots[_count] = er
                    end
                end
            end
        end
    end
end

-- =====================================================
-- MAIN LOOP — 5000+ HITS/S
-- =====================================================
RunService.RenderStepped:Connect(function()
    if not _G.FastAttack or not _fireServer then return end

    local char = LP.Character
    if not char then return end

    local root = char:FindFirstChild("HumanoidRootPart")
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not root or not hum then return end

    CancelAnims(hum)

    -- Click ×15
    for _ = 1, 15 do
        _sendClick(VIM, table.unpack(_click1))
        _sendClick(VIM, table.unpack(_click2))
    end

    ScanMobs(root)
    CleanupCounters()

    if _count > 0 then
        _args[4] = HASH
        for m = 1, _count do
            local mr = _roots[m]
            if mr and mr.Parent then
                _args[1] = mr
                local mob = mr.Parent
                SmartBypass(mob)
                -- Hit ×85 mỗi mob/frame
                for _ = 1, 85 do
                    _fireServer(HitRemote, table.unpack(_args))
                end
            end
        end
    end
end)

print("[Vexz FastAttack ULTIMATE] ON | 5000+ hits/s | Smart Bypass") 
