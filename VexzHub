--// Toggle
_G.FastAttack = false

--// Services
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local VirtualInputManager = game:GetService("VirtualInputManager")

--// Player
local LocalPlayer = Players.LocalPlayer

--// Remote
local HitRemote = ReplicatedStorage:WaitForChild("Modules")
    :WaitForChild("Net")
    :WaitForChild("RE/RegisterHit")

--// Enemies
local Enemies = workspace:WaitForChild("Enemies")

--// Config
local BURST = 3
local DIST = 150
local ATTACK_ID = "079996f9"

--// Hitbox ảo (không làm quái to)
local function getBestPart(mob)
    return mob:FindFirstChild("Head")
        or mob:FindFirstChild("HumanoidRootPart")
end

--// Click ảo
local function click()
    VirtualInputManager:SendMouseButtonEvent(0,0,0,true,game,0)
    VirtualInputManager:SendMouseButtonEvent(0,0,0,false,game,0)
end

--// START
function startFastAttack()
    if _G.FastAttack then return end
    _G.FastAttack = true

    task.spawn(function()
        while _G.FastAttack do
            
            local char = LocalPlayer.Character
            if not char then task.wait(0.1) continue end

            local root = char:FindFirstChild("HumanoidRootPart")
            if not root then task.wait(0.1) continue end

            -- click trước
            click()

            for _, mob in ipairs(Enemies:GetChildren()) do
                if not _G.FastAttack then break end

                local hum = mob:FindFirstChildOfClass("Humanoid")
                local part = getBestPart(mob)

                if hum and part and hum.Health > 0 then
                    local dist = (part.Position - root.Position).Magnitude

                    if dist <= DIST then
                        local args = {
                            [1] = part,
                            [2] = {}, -- giữ nguyên theo bạn
                            [4] = ATTACK_ID
                        }

                        -- 🔥 FAST ATTACK
                        for i = 1, BURST do
                            HitRemote:FireServer(unpack(args))
                        end
                    end
                end
            end

            task.wait(0.08) -- 🔥 nhịp chuẩn (đừng để 0)
        end
    end)
end

--// STOP
function stopFastAttack()
    _G.FastAttack = false
end
