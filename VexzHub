-- ✅ AUTO QUEST: Tự check level + Tìm NPC gần nhất
-- =====================================================
local function doAcceptQuest()
    if S.questBusy then return end
    S.questBusy = true
    local lv = getLevel()
    local info = getQuestInfo(lv)
    local npcPos = nil

    -- Tìm NPC gần nhất dựa trên quest name
    local npcFolder = workspace:FindFirstChild("NPCs") or workspace:FindFirstChild("NPC")
    if npcFolder then
        local bestDist = 20
        for _, v in ipairs(npcFolder:GetChildren()) do
            if v:IsA("Model") and v.Name:lower():find(info.npc:lower():sub(1,10), 1, true) then
                local hrp = v:FindFirstChild("HumanoidRootPart") or v.PrimaryPart
                if hrp then
                    local r = getRoot()
                    local d = r and (r.Position - hrp.Position).Magnitude or 999
                    if d < bestDist then
                        bestDist = d
                        npcPos = hrp.Position
                    end
                end
            end
        end
    end

    -- Fallback: tìm qua ProximityPrompt
    if not npcPos then
        for _, v in ipairs(workspace:GetDescendants()) do
            if v:IsA("ProximityPrompt") then
                local txt = (v.ActionText or "") .. (v.ObjectText or "")
                if txt:lower():find("quest") then
                    local p = v.Parent
                    if p and p:IsA("BasePart") then
                        npcPos = p.Position
                        break
                    end
                end
            end
        end
    end

    if npcPos then
        flyTo(npcPos + Vector3.new(0,3,-5), 300)
        task.wait(0.5)
    end

    pcall(function()
        if QuestRemote then
            QuestRemote:FireServer(info.npc)
        end
    end)
    task.wait(0.2)
    pcall(function()
        if QuestRemote then
            QuestRemote:FireServer(info.npc, true)
        end
    end)

    task.wait(0.5)

    if S.farm then
        if S.target and S.target.Parent then
            local er = S.target:FindFirstChild("HumanoidRootPart")
            if er then
                flyTo(er.Position + Vector3.new(0,10,0), 300)
                S.active = true
                startNoFall(S.target)
            end
        else
            local r = getRoot()
            if r then
                local next = findMobs(r.Position, 2000)
                if next then
                    local er = next:FindFirstChild("HumanoidRootPart")
                    if er then
                        flyTo(er.Position + Vector3.new(0,10,0), 300)
                        S.target = next
                        S.active = true
                        startNoFall(next)
                    end
                end
            end
        end
    end

    S.questBusy = false
end

