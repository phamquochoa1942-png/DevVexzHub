local function doAcceptQuest()
    if S.questBusy then return end
    S.questBusy = true

    local lv   = getPlayerLevel()
    local data = getQuestData(lv)
    print("[VexzHub] Quest Lv", lv, "-> NPC:", data.questNPC, "| Mob:", data.mobName)

    -- Bước 1: Tìm NPC trong workspace
    -- Blox Fruits NPC quest thường nằm trong workspace trực tiếp
    -- Tìm theo tên NPC hoặc ProximityPrompt
    local npcPart = nil
    local bestDist = math.huge
    local r0 = getRoot()
    if not r0 then S.questBusy = false; return end

    -- Quét tất cả descendants, tìm Part/Model gần nhất
    -- có tên chứa "Quest" hoặc tên NPC
    for _, v in pairs(workspace:GetDescendants()) do
        -- Ưu tiên ProximityPrompt vì đây là cách chính xác nhất
        if v:IsA("ProximityPrompt") then
            local part = v.Parent
            if part and part:IsA("BasePart") then
                local dist = (r0.Position - part.Position).Magnitude
                if dist < bestDist and dist < 3000 then
                    bestDist = dist
                    npcPart  = part
                end
            end
        end
    end

    -- Fallback: tìm Model tên chứa "Quest"
    if not npcPart then
        for _, v in pairs(workspace:GetDescendants()) do
            if v:IsA("Model") then
                local lower = v.Name:lower()
                if lower:find("quest") or lower:find("giver") then
                    local root = v:FindFirstChild("HumanoidRootPart")
                        or v:FindFirstChild("Head")
                        or v.PrimaryPart
                    if root then
                        local dist = (r0.Position - root.Position).Magnitude
                        if dist < bestDist and dist < 3000 then
                            bestDist = dist
                            npcPart  = root
                        end
                    end
                end
            end
        end
    end

    -- Bước 2: Bay đến NPC
    if npcPart then
        print("[VexzHub] Bay đến NPC:", npcPart:GetFullName(), "dist:", math.floor(bestDist))
        flyTo(npcPart.Position + Vector3.new(0, 3, -5), 300)
        task.wait(0.8)

        -- Trigger ProximityPrompt nếu có
        pcall(function()
            local pp = npcPart:FindFirstChildOfClass("ProximityPrompt")
                or npcPart.Parent:FindFirstChildOfClass("ProximityPrompt")
            if pp then
                fireproximityprompt(pp)
                print("[VexzHub] Fired ProximityPrompt")
                task.wait(0.3)
            end
        end)
    else
        print("[VexzHub] Không tìm thấy NPC, dùng FireServer trực tiếp")
    end

    -- Bước 3: FireServer
    -- Dùng real args nếu đã hook, không thì thử nhiều format
    if realQuestArgs and #realQuestArgs > 0 then
        pcall(function()
            local args = table.clone(realQuestArgs)
            QuestRemote:FireServer(table.unpack(args))
            print("[VexzHub] FireServer real args OK")
        end)
    else
        -- Thử tên NPC thật
        local names = {
            data.questNPC,           -- "Bandit Quest Giver"
            data.npcTitle,           -- "Bandit"
            data.questNPC .. " NPC", -- fallback
        }
        for _, name in ipairs(names) do
            pcall(function() QuestRemote:FireServer(name, true)  end)
            task.wait(0.05)
            pcall(function() QuestRemote:FireServer(name)        end)
            task.wait(0.05)
        end
        print("[VexzHub] FireServer fallback done")
    end

    task.wait(0.5)

    -- Bước 4: Quay lại farm
    if S.farm then
        local rr = getRoot()
        if rr then
            local nextMob = findMobs(rr.Position, 2000)
            if nextMob then
                local er = nextMob:FindFirstChild("HumanoidRootPart")
                if er then
                    flyTo(er.Position + Vector3.new(0, 10, 0), 300)
                    S.target = nextMob
                    S.active = true
                    startNoFall(nextMob)
                end
            end
        end
    end

    S.questBusy = false
    print("[VexzHub] Quest cycle done!")
end

-- =====================================================
-- MAIN FARM LOOP
-- =====================================================
task.spawn(function()
    while true do
        task.wait()
        if not S.farm or S.questBusy then
            if S.active and not S.questBusy then resetState() end
            continue
        end

        local r = getRoot()
        local h = getHum()
        if not r or not h or h.Health <= 0 then
            if S.active then resetState() end
            task.wait(0.2); continue
        end

        local closest, closestDist, nearby = findMobs(r.Position, 2000)

        if closest then
            if not S.active then
                S.active = true
                S.target = closest
                startNoFall(closest)
            end

            -- Cập nhật target khi mob chết
            if S.target then
                local teh = S.target:FindFirstChildOfClass("Humanoid")
                if not teh or teh.Health <= 0 or not S.target.Parent then
                    S.target = closest
                    startNoFall(closest)
                end
            end

            -- Tấn công tất cả mob gần (300 studs)
            for _, item in ipairs(nearby) do
                if not S.farm then break end
                if item.dist > 300 then continue end
                local mob = item.mob
                local eh = mob:FindFirstChildOfClass("Humanoid")
                local er = mob:FindFirstChild("HumanoidRootPart")
                if not eh or eh.Health <= 0 or not er then continue end

                pcall(function()
                    if realAttackArgs and #realAttackArgs > 0 then
                        -- Dùng args thật từ hook — đảm bảo dame
                        local args = table.clone(realAttackArgs)
                        args[1] = er
                        AttackRemote:FireServer(table.unpack(args))
                    else
                        -- Fallback khi chưa hook
                        AttackRemote:FireServer(er, {})
                    end
                end)
            end

            -- VirtualInput click
            VirtualInputManager:SendMouseButtonEvent(0,0,0,true,game,1)
            VirtualInputManager:SendMouseButtonEvent(0,0,0,false,game,1)

        else
            -- Hết mob → bay đàn tiếp theo
            if S.active then resetState() end
            if S.farm and not S.questBusy then
                local r2 = getRoot()
                if r2 then
                    local next, dist = findMobs(r2.Position, 2000)
                    if next then
                        local er = next:FindFirstChild("HumanoidRootPart")
                        if er then
                            flyTo(er.Position + Vector3.new(0, 10, 0), 300)
                            S.active = true
                            S.target = next
                            startNoFall(next)
                        end
                    end
                end
            end
        end
    end
end)

