-- Fast Attack + Animation Cancel — TỐC ĐỘ TỐI ĐA — by Quoc Hoa
_G.FastAttack = true

local Players           = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService        = game:GetService("RunService")
local VIM               = game:GetService("VirtualInputManager")
local LocalPlayer       = Players.LocalPlayer

local HitRemote = ReplicatedStorage.Modules.Net:FindFirstChild("RE/RegisterHit")

-- Hook hash tự động
local hash = "079baa9c"
pcall(function()
    local mt = getrawmetatable(game)
    local old = mt.__namecall
    setreadonly(mt, false)
    mt.__namecall = newcclosure(function(self, ...)
        if getnamecallmethod() == "FireServer" and self == HitRemote then
            local a = {...}
            if type(a[4]) == "string" and #a[4] >= 6 then
                hash = a[4]
            end
        end
        return old(self, ...)
    end)
    setreadonly(mt, true)
end)

local ATTACK_KEYWORDS = {
    "attack", "slash", "punch", "kick", "hit",
    "swing", "strike", "combo", "skill", "cast",
    "shoot", "throw", "smash", "dash", "ability"
}

local function isAttackAnim(track)
    local id = tostring(track.Animation and track.Animation.AnimationId or ""):lower()
    local name = track.Name:lower()
    for _, kw in ipairs(ATTACK_KEYWORDS) do
        if id:find(kw) or name:find(kw) then return true end
    end
    return false
end

local function cancelAttackAnims()
    local c = LocalPlayer.Character
    if not c then return end
    local hum = c:FindFirstChildOfClass("Humanoid")
    if not hum then return end
    for _, track in ipairs(hum:GetPlayingAnimationTracks()) do
        if isAttackAnim(track) then
            track:Stop(0)
        end
    end
end

-- Pre-cache tất cả mob trong 150 studs
local cachedMobs = {}

local function updateMobs()
    local r = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
    if not r then cachedMobs = {} return end
    local E = workspace:FindFirstChild("Enemies")
    if not E then cachedMobs = {} return end
    local list = {}
    for _, e in ipairs(E:GetChildren()) do
        if not e:IsA("Model") then continue end
        local h  = e:FindFirstChildOfClass("Humanoid")
        local er = e:FindFirstChild("HumanoidRootPart")
        if not h or h.Health <= 0 or not er then continue end
        if (r.Position - er.Position).Magnitude <= 150 then
            table.insert(list, er)
        end
    end
    cachedMobs = list
end

-- ═══════════════════════════════════════════════
-- LOOP CHÍNH — RenderStepped = 60 lần/giây
-- Chỉ làm 2 việc: Cancel anim + Click ảo
-- ═══════════════════════════════════════════════
RunService.RenderStepped:Connect(function()
    if not _G.FastAttack then return end

    cancelAttackAnims()

    VIM:SendMouseButtonEvent(0, 0, 0, true, game, 1)
    VIM:SendMouseButtonEvent(0, 0, 0, false, game, 1)
end)

-- ═══════════════════════════════════════════════
-- LOOP RIÊNG: FireServer mỗi 5 frame
-- Không block loop chính
-- ═══════════════════════════════════════════════
local hitFrame = 0
RunService.RenderStepped:Connect(function()
    if not _G.FastAttack then return end
    hitFrame += 1
    if hitFrame < 3 then return end  -- Mỗi 3 frame gửi 1 lần
    hitFrame = 0

    updateMobs()
    for _, mr in ipairs(cachedMobs) do
        pcall(function()
            HitRemote:FireServer(mr, {}, hash)
        end)
    end
end)

-- ═══════════════════════════════════════════════
-- LOOP PHỤ: Cancel animation liên tục song song
-- ═══════════════════════════════════════════════
task.spawn(function()
    while _G.FastAttack do
        task.wait(0)
        cancelAttackAnims()
    end
end)

print("[FA] ON | hash:", hash)
print("[FA] OFF: _G.FastAttack = false") 
