-- =====================================================
-- BRING MOB — set CFrame mỗi RenderStepped
-- Server replication ~30fps, RenderStepped ~60fps
-- → client kịp set trước server override
-- =====================================================
local bringConn = nil

local function startBring()
    if bringConn then bringConn:Disconnect() end

    bringConn = RunService.RenderStepped:Connect(function()
        if not S.bring or not S.farm then
            bringConn:Disconnect(); bringConn = nil
            return
        end
        local r = getRoot()
        if not r then return end
        local Enemies = workspace:FindFirstChild("Enemies")
        if not Enemies then return end

        local count = 0
        for _, e in ipairs(Enemies:GetChildren()) do
            if count >= S.bringCount then break end
            if not e:IsA("Model") then continue end
            local eh = e:FindFirstChildOfClass("Humanoid")
            local er = e:FindFirstChild("HumanoidRootPart")
            if not eh or eh.Health <= 0 or not er then continue end

            local dist = (r.Position - er.Position).Magnitude
            if dist > S.bringRange or dist < 5 then continue end

            -- Set CFrame mỗi frame — nhanh hơn server replication
            local lockPos = r.Position + Vector3.new(
                math.random(-6,6), 0, math.random(-6,6)
            )
            pcall(function()
                er.CFrame = CFrame.new(lockPos)
                er.Velocity = Vector3.zero
                er.AssemblyLinearVelocity = Vector3.zero
            end)

            -- Destroy Animator để mob không tự đi
            pcall(function()
                for _, desc in ipairs(e:GetDescendants()) do
                    if desc:IsA("Animator") or desc.Name == "Animate" then
                        desc:Destroy()
                    end
                end
            end)

            count += 1
        end
    end)
end

local function restoreMobs()
    if bringConn then bringConn:Disconnect(); bringConn = nil end
end

