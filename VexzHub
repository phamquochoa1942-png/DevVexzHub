-- Fast Attack — PREMIUM HUB QUALITY — by Quoc Hoa
-- Tốc độ: ~3000 hits/giây, Click ~600/giây
-- Không lag nhờ: Object Pool + Pre-allocated Memory + Single Loop
_G.FastAttack = true

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local VIM = game:GetService("VirtualInputManager")
local LocalPlayer = game.Players.LocalPlayer

-- Pre-allocate TẤT CẢ biến dùng lại
local CLICK_BATCH = 10
local HIT_BATCH = 50
local SCAN_RANGE = 200

local poolArgs = { nil, {}, "079baa9c" }
local mobRoots = {}
local mobCount = 0

-- Lấy Remote 1 lần, cache lại
local Modules = ReplicatedStorage:FindFirstChild("Modules")
local Net = Modules and Modules:FindFirstChild("Net")
local HitRemote = Net and Net:FindFirstChild("RE/RegisterHit")

local hash = "079baa9c"

-- Hook hash nhẹ
if HitRemote then
    pcall(function()
        local mt = getrawmetatable(game)
        local old = mt.__namecall
        setreadonly(mt, false)
        mt.__namecall = newcclosure(function(self, ...)
            if self == HitRemote then
                local a = {...}
                if type(a[4]) == "string" and #a[4] >= 6 then hash = a[4] end
            end
            return old(self, ...)
        end)
        setreadonly(mt, true)
    end)
end

-- Pre-cache workspace children lookup
local function fastScan(root)
    mobCount = 0
    local E = workspace:FindFirstChild("Enemies")
    if not E then return end
    local rx, ry, rz = root.Position.X, root.Position.Y, root.Position.Z
    for _, e in ipairs(E:GetChildren()) do
        if e:IsA("Model") then
            local h = e:FindFirstChildOfClass("Humanoid")
            if h and h.Health > 0 then
                local er = e:FindFirstChild("HumanoidRootPart")
                if er then
                    local dx = rx - er.Position.X
                    local dy = ry - er.Position.Y
                    local dz = rz - er.Position.Z
                    -- Fast distance check (no sqrt for filtering)
                    if dx*dx + dy*dy + dz*dz <= SCAN_RANGE * SCAN_RANGE then
                        mobCount += 1
                        mobRoots[mobCount] = er
                    end
                end
            end
        end
    end
end

-- Pre-load click function into local
local sendClick = VIM.SendMouseButtonEvent
local clickArgs1 = { 0, 0, 0, true, game, 1 }
local clickArgs2 = { 0, 0, 0, false, game, 1 }

-- Pre-load FireServer
local fireServer = HitRemote and HitRemote.FireServer

-- Main Loop — optimized to death
RunService.RenderStepped:Connect(function()
    if not _G.FastAttack or not fireServer then return end
    
    local c = LocalPlayer.Character
    if not c then return end
    
    local root = c:FindFirstChild("HumanoidRootPart")
    local hum = c:FindFirstChildOfClass("Humanoid")
    if not root or not hum then return end
    
    -- Cancel anim
    local tracks = hum:GetPlayingAnimationTracks()
    local tCount = #tracks
    for i = 1, tCount do tracks[i]:Stop(0) end
    
    -- Batch click
    for _ = 1, CLICK_BATCH do
        sendClick(VIM, unpack(clickArgs1))
        sendClick(VIM, unpack(clickArgs2))
    end
    
    -- Scan + Hit
    fastScan(root)
    if mobCount > 0 then
        poolArgs[4] = hash
        for m = 1, mobCount do
            local mr = mobRoots[m]
            if mr and mr.Parent then
                poolArgs[1] = mr
                for _ = 1, HIT_BATCH do
                    fireServer(HitRemote, unpack(poolArgs))
                end
            end
        end
    end
end) 
