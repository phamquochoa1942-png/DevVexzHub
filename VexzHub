_G.FastAttackAll = true

task.spawn(function()
    local ReplicatedStorage = game:GetService("ReplicatedStorage")
    local Players = game:GetService("Players")
    local RunService = game:GetService("RunService")
    local VirtualInputManager = game:GetService("VirtualInputManager")

    local LocalPlayer = Players.LocalPlayer
    local AttackRemote = ReplicatedStorage:WaitForChild("Modules")
        :WaitForChild("Net")
        :WaitForChild("RE/RegisterHit")

    local BURST = 3 -- 🔥 tăng hit mỗi lần
    local COOLDOWN = 0.06 -- 🔥 nhanh hơn

    -- click nhanh nhưng vừa đủ
    task.spawn(function()
        while _G.FastAttackAll do
            VirtualInputManager:SendMouseButtonEvent(0,0,0,true,game,0)
            VirtualInputManager:SendMouseButtonEvent(0,0,0,false,game,0)
            task.wait(0.03)
        end
    end)

    while _G.FastAttackAll do
        local Character = LocalPlayer.Character
        if not Character then task.wait(0.1) continue end
        
        local Root = Character:FindFirstChild("HumanoidRootPart")
        if not Root then task.wait(0.1) continue end

        local Enemies = workspace:FindFirstChild("Enemies")
        if not Enemies then task.wait(0.1) continue end

        for _, Enemy in ipairs(Enemies:GetChildren()) do
            if not _G.FastAttackAll then break end
            
            local Hum = Enemy:FindFirstChildOfClass("Humanoid")
            local HRP = Enemy:FindFirstChild("HumanoidRootPart")

            if Hum and HRP and Hum.Health > 0 then
                local dist = (Root.Position - HRP.Position).Magnitude

                if dist < 150 then
                    
                    -- 🔥 chọn part tốt hơn
                    local TargetPart =
                        Enemy:FindFirstChild("Head") or
                        Enemy:FindFirstChild("HumanoidRootPart")

                    local args = {
                        [1] = TargetPart,
                        [2] = {TargetPart}, -- ✅ FIX QUAN TRỌNG
                        [3] = nil,
                        [4] = "079996f9"
                    }

                    -- 🔥 BURST HIT
                    for i = 1, BURST do
                        AttackRemote:FireServer(unpack(args))
                    end
                end
            end
        end

        task.wait(COOLDOWN)
    end
end)
