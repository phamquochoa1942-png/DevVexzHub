--// Global Kill Switch
_G.SyncCombatEnabled = false

--// Services (localize 1 lần)
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local VirtualInputManager = game:GetService("VirtualInputManager")

--// Remote (cache sẵn, tránh lookup liên tục)
local remote = ReplicatedStorage:WaitForChild("Modules")
    :WaitForChild("Net")
    :WaitForChild("RE/RegisterAttack")

--// Config
local COOLDOWN = 0.12 -- (0.1 -> 0.15)
local attackDelay = 0.5
local attackId = "079baa9c"

--// Hàm chính
function syncCombatAction()
    if _G.SyncCombatEnabled then return end -- tránh chạy trùng
    
    _G.SyncCombatEnabled = true

    task.spawn(function()
        while _G.SyncCombatEnabled do
            
            --// Gửi Remote (đã tối ưu)
            remote:FireServer(attackDelay, attackId)
            
            --// Giả lập click chuột (Left Click)
            VirtualInputManager:SendMouseButtonEvent(0, 0, 0, true, game, 0)
            VirtualInputManager:SendMouseButtonEvent(0, 0, 0, false, game, 0)
            
            --// Cooldown chống spam
            task.wait(COOLDOWN)
        end
    end)
end

--// Hàm dừng (Kill Switch)
function stopCombatAction()
    _G.SyncCombatEnabled = false
end
