-- =====================================================
-- CHAR HELPERS
-- =====================================================
local function getRoot()
    local c = LocalPlayer.Character
    return c and c:FindFirstChild("HumanoidRootPart")
end

local function getHum()
    local c = LocalPlayer.Character
    return c and c:FindFirstChildOfClass("Humanoid")
end

local function resetState()
    S.active = false
    S.target = nil
    if S.noFallConn then S.noFallConn:Disconnect(); S.noFallConn = nil end
    workspace.Gravity = S.origGravity
    local c = LocalPlayer.Character
    if not c then return end
    local h = c:FindFirstChildOfClass("Humanoid")
    if h then
        h.WalkSpeed = 16; h.JumpPower = 50
        h.PlatformStand = false; h.AutoRotate = true
    end
    local r = c:FindFirstChild("HumanoidRootPart")
    if r then
        r.Velocity = Vector3.zero
        r.AssemblyLinearVelocity = Vector3.zero
    end
    for _, p in ipairs(c:GetDescendants()) do
        if p:IsA("BasePart") then p.CanCollide = true end
    end
end

local function lockChar()
    local c = LocalPlayer.Character
    if not c then return end
    local h = c:FindFirstChildOfClass("Humanoid")
    if h then
        h.WalkSpeed = 0; h.JumpPower = 0
        h.PlatformStand = true; h.AutoRotate = false
    end
    for _, p in ipairs(c:GetDescendants()) do
        if p:IsA("BasePart") and p.Name ~= "HumanoidRootPart" then
            p.CanCollide = false
        end
    end
end

-- =====================================================
-- NOFAIL — ghim trên đầu mob, chống tuột
-- =====================================================
local function startNoFall(mob)
    if S.noFallConn then S.noFallConn:Disconnect(); S.noFallConn = nil end
    workspace.Gravity = 0
    lockChar()

    S.noFallConn = RunService.RenderStepped:Connect(function()
        if not S.active then return end
        local r  = getRoot()
        if not r or not mob or not mob.Parent then return end
        local er = mob:FindFirstChild("HumanoidRootPart")
        local eh = mob:FindFirstChildOfClass("Humanoid")
        if not er or not eh or eh.Health <= 0 then return end
        -- Ghim vị trí + reset velocity mỗi frame
        r.CFrame               = er.CFrame * CFrame.new(0, 10, 0)
        r.Velocity             = Vector3.zero
        r.RotVelocity          = Vector3.zero
        r.AssemblyLinearVelocity  = Vector3.zero
        r.AssemblyAngularVelocity = Vector3.zero
    end)
end

-- =====================================================
-- FLY TO — bay đến vị trí bằng RenderStepped Lerp
-- Không dùng Tween vì hay bị block bởi NoFall
-- =====================================================
local function flyTo(pos, speed)
    speed = speed or 200
    if S.noFallConn then S.noFallConn:Disconnect(); S.noFallConn = nil end
    workspace.Gravity = 0
    lockChar()

    local done = false
    local conn
    conn = RunService.RenderStepped:Connect(function(dt)
        local r = getRoot()
        if not r then conn:Disconnect(); done = true; return end
        local diff = pos - r.Position
        if diff.Magnitude < 4 then
            r.CFrame = CFrame.new(pos)
            r.Velocity = Vector3.zero
            r.AssemblyLinearVelocity = Vector3.zero
            conn:Disconnect(); done = true; return
        end
        local step = math.min(speed * dt, diff.Magnitude)
        r.CFrame = CFrame.new(r.Position + diff.Unit * step)
        r.Velocity = Vector3.zero
        r.AssemblyLinearVelocity = Vector3.zero
    end)

    local t = 0
    repeat task.wait(0.05); t += 0.05 until done or t >= 12
end

-- =====================================================
-- FIND MOBS — quét folder Enemies
-- =====================================================
local function findMobs(fromPos, maxDist)
    local Enemies = workspace:FindFirstChild("Enemies")
    if not Enemies then return nil, math.huge, {} end

    local closest, closestDist = nil, maxDist or math.huge
    local nearby = {}

    for _, e in ipairs(Enemies:GetChildren()) do
        if not e:IsA("Model") then continue end
        local eh = e:FindFirstChildOfClass("Humanoid")
        local er = e:FindFirstChild("HumanoidRootPart")
        if not eh or eh.Health <= 0 or not er then continue end
        local dist = (fromPos - er.Position).Magnitude
        if dist <= (maxDist or math.huge) then
            table.insert(nearby, { mob = e, dist = dist })
            if dist < closestDist then
                closestDist = dist
                closest = e
            end
        end
    end

    return closest, closestDist, nearby
end

-- =====================================================
-- BRING MOB
-- Dùng Humanoid:MoveTo vì mob NetworkOwner = Server
-- Client không set CFrame mob được → MoveTo hợp lệ
-- =====================================================
local function bringMobs()
    local r = getRoot()
    if not r then return end
    local Enemies = workspace:FindFirstChild("Enemies")
    if not Enemies then return end

    local count = 0
    for _, e in ipairs(Enemies:GetChildren()) do
        if count >= S.bringCount then break end
        if not e:IsA("Model") then continue end
        local eh = e:FindFirstChildOfClass("Humanoid")
        local er = e:FindFirstChild("HumanoidRootPart")
        if not eh or eh.Health <= 0 or not er then continue end
        local dist = (r.Position - er.Position).Magnitude
        if dist <= S.bringRange then
            pcall(function()
                eh:MoveTo(r.Position + Vector3.new(
                    math.random(-4, 4), 0, math.random(-4, 4)
                ))
            end)
            count += 1
        end
    end
end

-- =====================================================
-- AUTO QUEST
-- 1. Check level hiện tại
-- 2. Tìm NPC quest trong workspace
-- 3. Bay đến NPC
-- 4. FireServer QuestUpdate
-- 5. Bay lại mob tiếp tục farm
-- =====================================================
local function doAcceptQuest()
    if S.questBusy then return end
    S.questBusy = true

    local lv   = getPlayerLevel()
    local data = getQuestData(lv)
    print("[VexzHub] Quest: Lv", lv, "→", data.questNPC)

    -- Bước 1: Tìm NPC trong workspace bằng nhiều cách
    local npcPos = nil

    -- Cách A: Tìm qua ProximityPrompt có ActionText chứa "Quest"
    for _, v in pairs(workspace:GetDescendants()) do
        if npcPos then break end
        if v:IsA("ProximityPrompt") then
            local txt = (v.ActionText or "") .. (v.ObjectText or "")
            if txt:lower():find("quest") then
                local p = v.Parent
                if p and p:IsA("BasePart") then
                    npcPos = p.Position
                    print("[VexzHub] Tìm NPC qua ProximityPrompt:", p:GetFullName())
                end
            end
        end
    end

    -- Cách B: Tìm NPC folder nếu có
    if not npcPos then
        local npcFolder = workspace:FindFirstChild("NPCs")
            or workspace:FindFirstChild("NPC")
        if npcFolder then
            for _, v in pairs(npcFolder:GetDescendants()) do
                if v:IsA("Model") and v.Name:lower():find("quest") then
                    local r2 = v:FindFirstChild("HumanoidRootPart") or v.PrimaryPart
                    if r2 then npcPos = r2.Position; break end
                end
            end
        end
    end

    -- Bước 2: Bay đến NPC nếu tìm thấy
    if npcPos then
        flyTo(npcPos + Vector3.new(0, 3, -5), 300)
        task.wait(0.5)
    end

    -- Bước 3: FireServer — thử 2 format phổ biến của Blox Fruits
    local questOK = false
    pcall(function()
        if QuestRemote then
            -- Format 1: chỉ tên NPC
            QuestRemote:FireServer(data.questNPC)
            questOK = true
        end
    end)
    task.wait(0.2)
    pcall(function()
        if QuestRemote then
            -- Format 2: tên NPC + extra
            QuestRemote:FireServer(data.questNPC, true)
        end
    end)

    print("[VexzHub] Quest FireServer:", data.questNPC, "OK:", questOK)
    task.wait(0.5)

    -- Bước 4: Bay lại mob để tiếp tục farm
    if S.farm then
        if S.target and S.target.Parent then
            local er = S.target:FindFirstChild("HumanoidRootPart")
            if er then
                flyTo(er.Position + Vector3.new(0, 10, 0), 300)
            end
            S.active = true
            startNoFall(S.target)
        else
            -- Tìm mob mới
            local r = getRoot()
            if r then
                local next = findMobs(r.Position, 2000)
                if next then
                    local er = next:FindFirstChild("HumanoidRootPart")
                    if er then
                        flyTo(er.Position + Vector3.new(0, 10, 0), 300)
                        S.target = next
                        S.active = true
                        startNoFall(next)
                    end
                end
            end
        end
    end

    S.questBusy = false
end

-- =====================================================
-- MAIN FARM LOOP
-- =====================================================
task.spawn(function()
    while true do
        task.wait()
        if not S.farm or S.questBusy then
            if S.active and not S.questBusy then resetState() end
            continue
        end

        local r = getRoot()
        local h = getHum()
        if not r or not h or h.Health <= 0 then
            if S.active then resetState() end
            task.wait(0.2); continue
        end

        local closest, closestDist, nearby = findMobs(r.Position, 2000)

        if closest then
            if not S.active then
                S.active = true
                S.target = closest
                startNoFall(closest)
            end

            -- Cập nhật target khi mob chết
            if S.target then
                local teh = S.target:FindFirstChildOfClass("Humanoid")
                if not teh or teh.Health <= 0 or not S.target.Parent then
                    S.target = closest
                    startNoFall(closest)
                end
            end

            -- Tấn công tất cả mob gần (300 studs)
            for _, item in ipairs(nearby) do
                if not S.farm then break end
                if item.dist > 300 then continue end
                local mob = item.mob
                local eh = mob:FindFirstChildOfClass("Humanoid")
                local er = mob:FindFirstChild("HumanoidRootPart")
                if not eh or eh.Health <= 0 or not er then continue end

                pcall(function()
                    if realAttackArgs and #realAttackArgs > 0 then
                        -- Dùng args thật từ hook — đảm bảo dame
                        local args = table.clone(realAttackArgs)
                        args[1] = er
                        AttackRemote:FireServer(table.unpack(args))
                    else
                        -- Fallback khi chưa hook
                        AttackRemote:FireServer(er, {})
                    end
                end)
            end

            -- VirtualInput click
            VirtualInputManager:SendMouseButtonEvent(0,0,0,true,game,1)
            VirtualInputManager:SendMouseButtonEvent(0,0,0,false,game,1)

        else
            -- Hết mob → bay đàn tiếp theo
            if S.active then resetState() end
            if S.farm and not S.questBusy then
                local r2 = getRoot()
                if r2 then
                    local next, dist = findMobs(r2.Position, 2000)
                    if next then
                        local er = next:FindFirstChild("HumanoidRootPart")
                        if er then
                            flyTo(er.Position + Vector3.new(0, 10, 0), 300)
                            S.active = true
                            S.target = next
                            startNoFall(next)
                        end
                    end
                end
            end
        end
    end
end)

-- Bring mob loop mỗi 2s
task.spawn(function()
    while true do
        task.wait(2)
        if S.farm and S.bring then bringMobs() end
    end
end)

-- Auto quest loop — check level mỗi 30s để tìm quest phù hợp
task.spawn(function()
    local lastLv = 0
    while true do
        task.wait(30)
        if not S.farm or not S.quest or S.questBusy then continue end
        local lv = getPlayerLevel()
        -- Quest khi level thay đổi hoặc mỗi 30s
        if lv ~= lastLv or true then
            lastLv = lv
            task.spawn(doAcceptQuest)
        end
    end
end)

