-- Fast Attack — LIMIT BREAKER v6 FIXED — by Quoc Hoa
_G.FastAttack = true

local Players           = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService        = game:GetService("RunService")
local VIM               = game:GetService("VirtualInputManager")
local LocalPlayer       = Players.LocalPlayer

local HitRemote = ReplicatedStorage:FindFirstChild("Modules")
    and ReplicatedStorage.Modules:FindFirstChild("Net")
    and ReplicatedStorage.Modules.Net:FindFirstChild("RE/RegisterHit")

local hash = "079baa9c"
pcall(function()
    if not HitRemote then return end
    local mt = getrawmetatable(game)
    local old = mt.__namecall
    setreadonly(mt, false)
    mt.__namecall = newcclosure(function(self, ...)
        if getnamecallmethod() == "FireServer" and self == HitRemote then
            local a = {...}
            if type(a[4]) == "string" and #a[4] >= 6 then hash = a[4] end
        end
        return old(self, ...)
    end)
    setreadonly(mt, true)
end)

local function cancelAll()
    local char = LocalPlayer.Character
    if not char then return end
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not hum then return end
    local tracks = hum:GetPlayingAnimationTracks()
    if #tracks > 0 then
        for _, track in ipairs(tracks) do
            track:Stop(0)
        end
    end
end

local function getRoot()
    local c = LocalPlayer.Character
    return c and c:FindFirstChild("HumanoidRootPart")
end

local cachedMobs = {}

local function fastClick(n)
    for _ = 1, n do
        VIM:SendMouseButtonEvent(0, 0, 0, true,  game, 1)
        VIM:SendMouseButtonEvent(0, 0, 0, false, game, 1)
    end
end

local function fastHit(mr, n)
    pcall(function()
        for _ = 1, n do
            HitRemote:FireServer(mr, {}, hash)
        end
    end)
end

local lastChar = nil
local function getChar()
    local c = LocalPlayer.Character
    if c ~= lastChar then
        lastChar = c
    end
    return lastChar
end

RunService.RenderStepped:Connect(function(dt)
    if not _G.FastAttack then return end
    cancelAll()
    fastClick(50)
    cancelAll()
    local r = getRoot()
    if r then
        local E = workspace:FindFirstChild("Enemies")
        if E then
            local list = {}
            for _, e in ipairs(E:GetChildren()) do
                if not e:IsA("Model") then continue end
                local h  = e:FindFirstChildOfClass("Humanoid")
                local er = e:FindFirstChild("HumanoidRootPart")
                if h and h.Health > 0 and er then
                    local dist = (r.Position - er.Position).Magnitude
                    if dist <= 200 then
                        list[#list + 1] = er
                    end
                end
            end
            cachedMobs = list
        end
    end
    if #cachedMobs > 0 then
        for _, mr in ipairs(cachedMobs) do
            fastHit(mr, 50)
        end
    end
end)

task.spawn(function()
    while _G.FastAttack do
        cancelAll()
        RunService.Heartbeat:Wait()
    end
end)

print("[FastAttack v6 FIXED] ON | No Lag + Max Speed") 
