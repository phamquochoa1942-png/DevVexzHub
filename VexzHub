-- ✅ BRING MOB: Kéo về + Freeze Animation (đứng im)
-- =====================================================
local function bringMobs()
    local r = getRoot()
    if not r then return end
    local Enemies = workspace:FindFirstChild("Enemies")
    if not Enemies then return end
    local count = 0
    for _, e in ipairs(Enemies:GetChildren()) do
        if count >= S.bringCount then break end
        if not e:IsA("Model") then continue end
        local eh = e:FindFirstChildOfClass("Humanoid")
        local er = e:FindFirstChild("HumanoidRootPart")
        if not eh or eh.Health<=0 or not er then continue end
        local dist = (r.Position - er.Position).Magnitude
        if dist <= S.bringRange then
            pcall(function()
                eh:MoveTo(r.Position + Vector3.new(math.random(-6,6), 0, math.random(-6,6)))
                eh.WalkSpeed = 0
                eh.JumpPower = 0
                for _, anim in ipairs(eh:GetPlayingAnimationTracks()) do
                    anim:Stop()
                end
                local torso = e:FindFirstChild("Torso") or e:FindFirstChild("UpperTorso")
                if torso then
                    torso.Velocity = Vector3.zero
                    torso.RotVelocity = Vector3.zero
                    torso.AssemblyLinearVelocity = Vector3.zero
                    torso.AssemblyAngularVelocity = Vector3.zero
                end
            end)
            count += 1
        end
    end
end

