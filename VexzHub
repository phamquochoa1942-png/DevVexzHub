        -- Nhận quest nếu chưa có
        if not questVisible then
            print("[Farm] Bay den NPC:", qData.Qname)
            tweenTo(qData.PosQ, 250)
            task.wait(0.5)
            pcall(function() ReplicatedStorage.Remotes.CommF_:InvokeServer("StartQuest", qData.Qname, qData.Qdata) end)
            print("[Farm] Da nhan quest:", qData.Qname)
            task.wait(0.5)
            if qData.PosM then tweenTo(qData.PosM, 300); task.wait(0.3) end
            continue
        end

        -- Kiểm tra CurrentMob còn sống
        if CurrentMob then
            local mh = CurrentMob:FindFirstChildOfClass("Humanoid")
            if not CurrentMob.Parent or not mh or mh.Health <= 0 then stopNoFall(); CurrentMob = nil end
        end

        -- Tìm mob mới
        if not CurrentMob then CurrentMob = GetNearestMob(qData.Mon) end

        if not CurrentMob then
            if qData.PosM then tweenTo(qData.PosM, 200) end
            task.wait(0.5); continue
        end

        -- Bay đến mob + ghim
        local mobRoot = CurrentMob:FindFirstChild("HumanoidRootPart")
        if not mobRoot then CurrentMob = nil; continue end

        FarmPos = mobRoot.Position
        print("[Farm] Bay den mob:", qData.Mon)
        tweenTo(mobRoot.CFrame * CFrame.new(0, 15, 0), 300)
        startNoFall(CurrentMob)

        -- Ở trên đầu mob đến khi chết
        repeat
            task.wait(0.1)
            if not CurrentMob or not CurrentMob.Parent then break end
            local mh2 = CurrentMob:FindFirstChildOfClass("Humanoid")
            if not mh2 or mh2.Health <= 0 then break end
            if CurrentMob:FindFirstChild("HumanoidRootPart") then
                FarmPos = CurrentMob.HumanoidRootPart.Position
            end
        until not StartFarm

        print("[Farm] Mob da chet, tim con moi...")
        stopNoFall(); CurrentMob = nil
    end
end)

