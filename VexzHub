-- ╔══════════════════════════════════════════════════╗
-- ║  FAST ATTACK — BANANA HUB QUALITY v2           ║
-- ║  Tốc độ: ~3000 hits/s | Fix Lag + Bypass       ║
-- ╚══════════════════════════════════════════════════╝
_G.FastAttack = true

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local VIM = game:GetService("VirtualInputManager")
local LP = game.Players.LocalPlayer

-- =====================================================
-- REMOTE + HASH
-- =====================================================
local HitRemote = ReplicatedStorage:FindFirstChild("Modules")
    and ReplicatedStorage.Modules:FindFirstChild("Net")
    and ReplicatedStorage.Modules.Net:FindFirstChild("RE/RegisterHit")

local HASH = "079baa9c"

if HitRemote then
    pcall(function()
        local mt = getrawmetatable(game)
        local old = mt.__namecall
        setreadonly(mt, false)
        mt.__namecall = newcclosure(function(self, ...)
            if self == HitRemote then
                local args = {...}
                if type(args[4]) == "string" and #args[4] >= 6 then
                    HASH = args[4]
                end
            end
            return old(self, ...)
        end)
        setreadonly(mt, true)
    end)
end

-- =====================================================
-- BYPASS: Chống giảm sát thương + giữ mob luôn hit được
-- =====================================================
local function Bypass(mob)
    pcall(function()
        -- Mở rộng hitbox mob để luôn đánh trúng
        for _, part in ipairs(mob:GetDescendants()) do
            if part:IsA("BasePart") and part.Size.Magnitude < 30 then
                part.Size = Vector3.new(25, 25, 25)
                part.CanCollide = false
                part.Transparency = 1
            end
        end
        
        -- Xóa Animator để mob không dance → luôn nhận hit
        local hum = mob:FindFirstChildOfClass("Humanoid")
        if hum then
            hum.WalkSpeed = 0
            hum.JumpPower = 0
            for _, anim in ipairs(mob:GetDescendants()) do
                if anim:IsA("Animator") or anim.Name == "Animate" then
                    anim:Destroy()
                end
            end
        end
    end)
end

-- =====================================================
-- PRE-ALLOCATED MEMORY
-- =====================================================
local _click1 = { 0, 0, 0, true,  game, 1 }
local _click2 = { 0, 0, 0, false, game, 1 }
local _args   = { nil, {}, HASH }
local _roots  = {}
local _bypassed = {} -- Cache mob đã bypass
local _count  = 0

local _sendClick = VIM.SendMouseButtonEvent
local _fireServer = HitRemote and HitRemote.FireServer

-- =====================================================
-- CANCEL ANIMATION
-- =====================================================
local function CancelAnims(hum)
    local tracks = hum:GetPlayingAnimationTracks()
    for i = 1, #tracks do tracks[i]:Stop(0) end
end

-- =====================================================
-- SCAN + BYPASS MOBS
-- =====================================================
local function ScanAndBypass(root, enemies)
    _count = 0
    local rx, ry, rz = root.Position.X, root.Position.Y, root.Position.Z
    for _, e in ipairs(enemies:GetChildren()) do
        if e:IsA("Model") then
            local h = e:FindFirstChildOfClass("Humanoid")
            if h and h.Health > 0 then
                local er = e:FindFirstChild("HumanoidRootPart")
                if er then
                    local dx, dy, dz = rx - er.Position.X, ry - er.Position.Y, rz - er.Position.Z
                    if dx*dx + dy*dy + dz*dz <= 40000 then
                        _count += 1
                        _roots[_count] = er
                        -- Bypass mob mới (chỉ làm 1 lần)
                        if not _bypassed[e] then
                            _bypassed[e] = true
                            Bypass(e)
                        end
                    end
                end
            end
        end
    end
    -- Cleanup mob đã chết khỏi cache bypass
    for mob, _ in pairs(_bypassed) do
        if not mob.Parent or (mob:FindFirstChildOfClass("Humanoid") and mob.Humanoid.Health <= 0) then
            _bypassed[mob] = nil
        end
    end
end

-- =====================================================
-- MAIN LOOP
-- =====================================================
RunService.RenderStepped:Connect(function()
    if not _G.FastAttack or not _fireServer then return end

    local char = LP.Character
    if not char then return end

    local root = char:FindFirstChild("HumanoidRootPart")
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not root or not hum then return end

    CancelAnims(hum)

    -- Click ×10
    for _ = 1, 10 do
        _sendClick(VIM, table.unpack(_click1))
        _sendClick(VIM, table.unpack(_click2))
    end

    -- Scan + Bypass
    local enemies = workspace:FindFirstChild("Enemies")
    if enemies then
        ScanAndBypass(root, enemies)
    end

    -- Hit ×50 mỗi mob
    if _count > 0 then
        _args[4] = HASH
        pcall(function()
            for m = 1, _count do
                local mr = _roots[m]
                if mr and mr.Parent then
                    _args[1] = mr
                    for _ = 1, 50 do
                        _fireServer(HitRemote, table.unpack(_args))
                    end
                end
            end
        end)
    end
end)

print("[Vexz FastAttack v2] ON | Bypass + Fix Lag | Hash:", HASH) 
