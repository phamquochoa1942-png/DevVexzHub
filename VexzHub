-- MAIN FARM LOOP
-- =====================================================
task.spawn(function()
    while true do
        task.wait()
        if not S.farm or S.questBusy then
            if S.active and not S.questBusy then resetState() end
            continue
        end
        local r = getRoot()
        local h = getHum()
        if not r or not h or h.Health<=0 then
            if S.active then resetState() end
            task.wait(0.2); continue
        end
        local closest, _, nearby = findMobs(r.Position, 2000)
        if closest then
            if not S.active then
                S.active = true; S.target = closest; startNoFall(closest)
            end
            if S.target then
                local teh = S.target:FindFirstChildOfClass("Humanoid")
                if not teh or teh.Health<=0 or not S.target.Parent then
                    S.target = closest; startNoFall(closest)
                end
            end
            for _, item in ipairs(nearby) do
                if not S.farm then break end
                if item.dist > 300 then continue end
                local mob = item.mob
                local eh = mob:FindFirstChildOfClass("Humanoid")
                local er = mob:FindFirstChild("HumanoidRootPart")
                if not eh or eh.Health<=0 or not er then continue end
                pcall(function()
                    if realAttackArgs and #realAttackArgs>0 then
                        local args = table.clone(realAttackArgs)
                        args[1] = er
                        AttackRemote:FireServer(table.unpack(args))
                    else
                        AttackRemote:FireServer(er, {})
                    end
                end)
            end
            VirtualInputManager:SendMouseButtonEvent(0,0,0,true,game,1)
            VirtualInputManager:SendMouseButtonEvent(0,0,0,false,game,1)
        else
            if S.active then resetState() end
            if S.farm and not S.questBusy then
                local r2 = getRoot()
                if r2 then
                    local next = findMobs(r2.Position, 2000)
                    if next then
                        local er = next:FindFirstChild("HumanoidRootPart")
                        if er then
                            flyTo(er.Position + Vector3.new(0,10,0), 300)
                            S.active = true; S.target = next; startNoFall(next)
                        end
                    end
                end
            end
        end
    end
end)

-- Bring Mob loop
task.spawn(function()
    while true do
        task.wait(2)
        if S.farm and S.bring then bringMobs() end
    end
end)

-- Auto Quest loop
task.spawn(function()
    local lastLv = 0
    while true do
        task.wait(30)
        if not S.farm or not S.quest or S.questBusy then continue end
        local lv = getLevel()
        if lv ~= lastLv then
            lastLv = lv
            task.spawn(doAcceptQuest)
        end
    end
end)

