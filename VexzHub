FarmingSection:AddToggle("StartFarm", { Title = "Start Farm", Default = false, Callback = function(v)
    S.farm = v
    if not v and S.active then resetState() end
    if v then
        -- Khi bật farm: nhận quest trước nếu autoquest bật
        if S.quest then task.spawn(doAcceptQuest) end
        -- Sau đó tìm mob
        task.spawn(function()
            task.wait(S.quest and 2 or 0)
            local r = getRoot()
            if r then
                local next = (findMobs(r.Position, 2000))
                if next then
                    local er = next:FindFirstChild("HumanoidRootPart")
                    if er then
                        flyTo(er.Position + Vector3.new(0,10,0), 300)
                        S.active = true
                        S.target = next
                        startNoFall(next)
                    end
                end
            end
        end)
    end
    print("[VexzHub] Farm:", v)
end });

