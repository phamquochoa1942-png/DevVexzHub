-- Fast Attack + Animation Cancel — Frame Perfect — by Quoc Hoa
_G.FastAttack = true

local Players           = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService        = game:GetService("RunService")
local VIM               = game:GetService("VirtualInputManager")
local LocalPlayer       = Players.LocalPlayer

-- Remote hit (Blox Fruits)
local HitRemote = ReplicatedStorage:FindFirstChild("Modules")
    and ReplicatedStorage.Modules:FindFirstChild("Net")
    and ReplicatedStorage.Modules.Net:FindFirstChild("RE/RegisterHit")

-- Hook hash tự động
local hash = "079baa9c"
pcall(function()
    if not HitRemote then return end
    local mt = getrawmetatable(game)
    local old = mt.__namecall
    setreadonly(mt, false)
    mt.__namecall = newcclosure(function(self, ...)
        if getnamecallmethod() == "FireServer" and self == HitRemote then
            local a = {...}
            if type(a[4]) == "string" and #a[4] >= 6 then
                hash = a[4]
            end
        end
        return old(self, ...)
    end)
    setreadonly(mt, true)
end)

-- Danh sách keywords animation cần cancel
local ATTACK_KEYWORDS = {
    "attack", "slash", "punch", "kick", "hit",
    "swing", "strike", "combo", "skill", "cast",
    "shoot", "throw", "smash", "dash", "ability",
    "stab", "cleave", "chop", "jab", "uppercut",
    "m1", "light", "heavy", "slam", "spin", "m2",
}

-- Kiểm tra 1 track có phải animation tấn công không
local function isAttackAnim(track)
    local id   = tostring(track.Animation and track.Animation.AnimationId or ""):lower()
    local name = track.Name:lower()
    for _, kw in ipairs(ATTACK_KEYWORDS) do
        if id:find(kw) or name:find(kw) then
            return true
        end
    end
    return false
end

-- Frame-perfect Animation Cancel
local function cancelAttackAnims()
    local char = LocalPlayer.Character
    if not char then return end
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not hum then return end
    for _, track in ipairs(hum:GetPlayingAnimationTracks()) do
        if isAttackAnim(track) then
            track:Stop(0)  -- Stop ngay lập tức, không fade
        end
    end
end

-- Helper: lấy HumanoidRootPart của nhân vật
local function getRoot()
    local c = LocalPlayer.Character
    return c and c:FindFirstChild("HumanoidRootPart")
end

-- Lấy danh sách mob trong tầm
local function getNearbyMobs(maxDist)
    local r = getRoot()
    if not r then return {} end
    local E = workspace:FindFirstChild("Enemies")
    if not E then return {} end
    local list = {}
    for _, e in ipairs(E:GetChildren()) do
        if not e:IsA("Model") then continue end
        local h  = e:FindFirstChildOfClass("Humanoid")
        local er = e:FindFirstChild("HumanoidRootPart")
        if not h or h.Health <= 0 or not er then continue end
        if (r.Position - er.Position).Magnitude <= (maxDist or 150) then
            table.insert(list, er)
        end
    end
    return list
end

-- ============================================
-- LOOP CHÍNH — RenderStepped = 60 Hz
-- Mỗi frame:
--   1. Cancel animation
--   2. Click ảo
-- ============================================
RunService.RenderStepped:Connect(function()
    if not _G.FastAttack then return end
    cancelAttackAnims()
    VIM:SendMouseButtonEvent(0, 0, 0, true,  game, 1)
    VIM:SendMouseButtonEvent(0, 0, 0, false, game, 1)
end)

-- ============================================
-- LOOP GỬI REMOTE — mỗi 3 frame (20 lần/giây)
-- ============================================
local hitFrame = 0
RunService.RenderStepped:Connect(function()
    if not _G.FastAttack then return end
    hitFrame += 1
    if hitFrame < 3 then return end
    hitFrame = 0

    local mobs = getNearbyMobs(150)
    for _, mr in ipairs(mobs) do
        pcall(function()
            HitRemote:FireServer(mr, {}, hash)
        end)
    end
end)

-- ============================================
-- LOOP PHỤ — Cancel animation siêu nhanh
-- ============================================
task.spawn(function()
    while _G.FastAttack do
        task.wait(0)
        cancelAttackAnims()
    end
end)

print("[FastAttack] ON | Hash:", hash)
print("[FastAttack] OFF: _G.FastAttack = false") 
